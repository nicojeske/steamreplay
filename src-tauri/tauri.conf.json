{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamReplay",
  "version": "../package.json",
  "identifier": "de.steamreplay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SteamReplay",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SteamReplay",
    "shortDescription": "Find and export the loud moments in Steam game recordings",
    "longDescription": "Lists Steam Game Recording sessions, shows their audio waveform with Steam's markers and the loud parts, and exports MP4 clips.",
    "copyright": "© 2026 Nico Jeske",
    "category": "Video",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "SteamReplay",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "license": "GPL-3.0-only",
    "resources": {
      "resources/models/*": "models/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMTNCM0Y4QTBBMkQzQzgKUldUSTA2S2crTE1URWQ3TVNWNksvd2VoNmtPMi9VVGV2QmVKYmozTkh2TzVOTUt2YjJTUHhUTlYK",
      "endpoints": [
        "https://github.com/nicojeske/steamreplay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
